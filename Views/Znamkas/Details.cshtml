@model EvidenciaStudentov.Models.Znamka

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Znamka</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Hodnota)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Hodnota)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Datum)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Datum)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Predmet)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Predmet?.Nazov ?? "-")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Pouzivatel)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Pouzivatel?.Email ?? "-")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.ZnamkaId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
