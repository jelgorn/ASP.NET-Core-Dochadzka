@model EvidenciaStudentov.Models.Predmet

@{
    ViewData["Title"] = "Odstrániť predmet";
}

<div class="container py-5">
    <h1 class="text-center text-danger fw-bold mb-4">🗑️ Odstrániť predmet</h1>

    <div class="card shadow-sm p-4 rounded bg-white">
        <h5 class="mb-4">Naozaj chcete odstrániť tento predmet?</h5>

        <dl class="row">
            <dt class="col-sm-3">Názov</dt>
            <dd class="col-sm-9">@Model.Nazov</dd>

            <dt class="col-sm-3">Popis</dt>
            <dd class="col-sm-9">@Model.Popis</dd>

            <dt class="col-sm-3">Učiteľ</dt>
            <dd class="col-sm-9">@Model.Ucitel?.Email</dd>
        </dl>

        <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
            <input type="hidden" asp-for="PredmetId" />
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">⬅️ Späť</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4">🗑️ Odstrániť</button>
        </form>
    </div>
</div>
