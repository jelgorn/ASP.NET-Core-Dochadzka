@model EvidenciaStudentov.Models.Predmet

@{
    ViewData["Title"] = "Upraviť predmet";
}

<div class="container py-5">
    <h1 class="text-center fw-bold mb-4">✏️ Upraviť predmet</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Edit" class="shadow p-4 rounded bg-white">
                <input type="hidden" asp-for="PredmetId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nazov" class="form-label">Názov</label>
                    <input asp-for="Nazov" class="form-control rounded-pill" />
                    <span asp-validation-for="Nazov" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Popis" class="form-label">Popis</label>
                    <input asp-for="Popis" class="form-control rounded-pill" />
                    <span asp-validation-for="Popis" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="UcitelId" class="form-label">Učiteľ</label>
                    <select asp-for="UcitelId" class="form-select rounded-pill" asp-items="ViewBag.UcitelId"></select>
                    <span asp-validation-for="UcitelId" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="custom-toggle-btn rounded-pill px-4 py-2">Späť</a>
                    <button type="submit" class="custom-toggle-btn rounded-pill px-4 py-2">Uložiť</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
