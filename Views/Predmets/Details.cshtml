@model EvidenciaStudentov.Models.Predmet

@{
    ViewData["Title"] = "Detail predmetu";
}

<div class="container py-5">
    <h1 class="text-center fw-bold mb-4">📘 Detail predmetu</h1>

    <div class="card shadow rounded p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Názov</dt>
            <dd class="col-sm-9">@Model.Nazov</dd>

            <dt class="col-sm-3">Popis</dt>
            <dd class="col-sm-9">@Model.Popis</dd>

            <dt class="col-sm-3">Učiteľ</dt>
            <dd class="col-sm-9">@Model.Ucitel?.Email</dd>
        </dl>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">⬅️ Späť</a>
        <a asp-action="Edit" asp-route-id="@Model?.PredmetId" class="btn btn-primary rounded-pill">✏️ Upraviť</a>
    </div>
</div>
