@model List<EvidenciaStudentov.ViewModels.NovaZnamkaViewModel>

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container mt-5">

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column align-items-center gap-3">
            @foreach (var znamka in Model)
            {
                <div class="alert alert-info shadow-sm w-100" style="max-width: 600px; border-left: 5px solid #17A2B8;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-clipboard-check me-3" style="font-size: 2rem; color: #17A2B8;"></i>
                            <div>
                                <h5 class="alert-heading mb-1" style="color: black;">Predmet: <strong>@znamka.Predmet</strong></h5>
                                <p class="mb-0 text-muted" style="font-size: 0.9rem; color: black;">Pridané: @znamka.Datum.ToString("dd.MM.yyyy")</p>
                            </div>
                        </div>
                        <div>
                            <span class="badge bg-success" style="font-size: 1rem ;">Známka: @znamka.Hodnota</span>
                        </div>
                    </div>
                </div>
            }
        </div>

    }
    else
    {
        <div class="alert alert-warning text-center" role="alert" style="font-size: 1.2em;">
            Momentálne nemáte žiadne nové notifikácie.
        </div>
    }

    <div class="text-center mt-4">
        <a href="/Student/Index" class="btn btn-outline-secondary btn-lg">Späť na hlavnú stránku</a>
    </div>
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
