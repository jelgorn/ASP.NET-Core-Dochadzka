@using Microsoft.CodeAnalysis.Differencing
@using Microsoft.VisualStudio.Web.CodeGenerators.Mvc.Templates.Blazor


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Aplik·cia na evidenciu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column min-vh-100">


    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="~/images/logo.svg" alt="Logo" class="navbar-logo me-2">
                <span class="fw-bold text-white">EduApp</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="d-flex align-items-center">
                <ul class="navbar-nav me-4">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        if (User.IsInRole("admin"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Admin/Index">Domov</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Pouzivatels/Index">Spr·va pouûÌvateæov</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Predmets/Index">Spr·va predmetov</a></li>
                            <li class="nav-item"><a class="nav-link" href="/PriradeniePredmetovUciteloms/Index">Priradiù predmety uËiteæom</a></li>
                            <li class="nav-item"><a class="nav-link" href="/PriradeniePredmetovZiakoms/Index">Priradiù predmety ûiakom</a></li>
                        }
                        else if (User.IsInRole("ucitel"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Ucitel/Index">Domov</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Ucitel/Znamky">Moje Predmety</a></li>
                        }
                        else if (User.IsInRole("ziak"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Student/Index">Domov </a></li>
                            <li class="nav-item"><a class="nav-link" href="/Student/VsetkyZnamky">Zn·mky</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Student/Dochadzka">Doch·dzka</a></li>
                            
                        }
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-3">
                            <span class="navbar-text text-white">
                                Prihl·sen˝: @User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")?.Value
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-logout px-4 py-2 fw-semibold rounded-pill shadow-sm">
                                    Odhl·siù
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <button class="btn btn-login px-4 py-2 fw-semibold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Prihl·siù
                            </button>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    
        @RenderBody()

        <!-- LOGIN MODAL -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg rounded-4">
                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="modal-header border-0 pb-0">
                        <h4 class="modal-title w-100 text-center fw-bold" id="loginModalLabel">Vitaj sp‰ù</h4>
                        <button type="button" class="btn-close position-absolute end-0 me-3 mt-3" data-bs-dismiss="modal" aria-label="Zavrieù"></button>
                    </div>
                    <div class="modal-body px-5 pb-4 pt-3">
                        <p class="text-center text-muted mb-4">Zadaj svoje prihlasovacie ˙daje</p>

                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">Emailov· adresa</label>
                            <input type="email" class="form-control rounded-3 shadow-sm" id="email" name="Email" placeholder="tvoj@email.sk" required />
                        </div>
                        <div class="mb-4">
                            <label for="heslo" class="form-label fw-semibold">Heslo</label>
                            <input type="password" class="form-control rounded-3 shadow-sm" id="heslo" name="Heslo" placeholder="Heslo" required />
                        </div>

                        <div id="loginErrorContainer" class="alert alert-danger d-none mt-3 rounded-3">
                            <span id="loginErrorMessage"></span>
                        </div>
                    </div>
                    <div class="modal-footer border-0 px-5 pb-4">
                        <div class="w-100">
                            <button type="submit" class="btn w-100 rounded-pill py-2 fw-semibold shadow-sm text-white"
                                    style="background-color: #17A2B8; border-color: #17A2B8 ;">
                                Prihl·siù sa
                            </button>

                            <div class="mt-3 p-3 rounded-3 border bg-light text-start">
                                <div class="fw-semibold mb-2">Demo prihl·senie</div>
                                <div class="small mb-1"><strong>Admin:</strong> admin@demo.sk / Admin123!</div>
                                <div class="small mb-3"><strong>User (ûiak):</strong> user@demo.sk / User123!</div>
                                <div class="d-grid gap-2">
                                    <button type="button" id="fillDemoAdmin" class="btn btn-outline-secondary btn-sm">Vyplniù demo admin</button>
                                    <button type="button" id="fillDemoUser" class="btn btn-outline-secondary btn-sm">Vyplniù demo user</button>
                                </div>
                            </div>

                            <button type="button" class="btn btn-link text-muted mt-2" data-bs-dismiss="modal">Zavrieù</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  window.addEventListener("DOMContentLoaded", function () {
    const loginError = '@TempData["LoginError"]';
    const emailInput = document.getElementById("email");
    const hesloInput = document.getElementById("heslo");
    const loginErrorContainer = document.getElementById("loginErrorContainer");
    const loginErrorMessage = document.getElementById("loginErrorMessage");

    const fillDemoCredentials = (email, heslo) => {
        if (!emailInput || !hesloInput) {
            return;
        }

        emailInput.value = email;
        hesloInput.value = heslo;

        if (loginErrorContainer) {
            loginErrorContainer.classList.add("d-none");
        }
        if (loginErrorMessage) {
            loginErrorMessage.innerText = "";
        }
    };

    const fillDemoAdminButton = document.getElementById("fillDemoAdmin");
    if (fillDemoAdminButton) {
        fillDemoAdminButton.addEventListener("click", function () {
            fillDemoCredentials("admin@demo.sk", "Admin123!");
        });
    }

    const fillDemoUserButton = document.getElementById("fillDemoUser");
    if (fillDemoUserButton) {
        fillDemoUserButton.addEventListener("click", function () {
            fillDemoCredentials("user@demo.sk", "User123!");
        });
    }

    if (loginError && loginError !== '') {
        const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
        loginModal.show();
        if (loginErrorMessage) {
            loginErrorMessage.innerText = loginError;
        }
        if (loginErrorContainer) {
            loginErrorContainer.classList.remove("d-none");
        }
    }
});
</script>


    
    <footer class="footer flex-shrink-0 mt-auto">
        © 2025 EduApp | Vytvoril: Sebasti·n äatan |
        <a href="https://github.com/jelgorn" target="_blank">GitHub profil</a>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

