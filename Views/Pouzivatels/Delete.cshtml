@model EvidenciaStudentov.Models.Pouzivatel

@{
    ViewData["Title"] = "Odstrániť používateľa";
}

<div class="container py-5">
    <h1 class="text-center text-danger fw-bold mb-4">🗑️ Odstrániť používateľa</h1>

    <div class="card shadow p-4 rounded bg-white">
        <h5>Ste si istý, že chcete odstrániť tohto používateľa?</h5>

        <dl class="row mt-4">
            <dt class="col-sm-4">Meno</dt>
            <dd class="col-sm-8">@Model.Meno</dd>

            <dt class="col-sm-4">Priezvisko</dt>
            <dd class="col-sm-8">@Model.Priezvisko</dd>

            <dt class="col-sm-4">Dátum narodenia</dt>
            <dd class="col-sm-8">@Model.DatumNarodenia.ToShortDateString()</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Rola</dt>
            <dd class="col-sm-8">@Model.Rola</dd>
        </dl>

        <form asp-action="Delete" class="mt-4 d-flex justify-content-between">
            <input type="hidden" asp-for="PouzivatelId" />
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">⬅️ Späť</a>
            <button type="submit" class="btn btn-danger rounded-pill px-4">🗑️ Odstrániť</button>
        </form>
    </div>
</div>
