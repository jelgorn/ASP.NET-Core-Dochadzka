@model IEnumerable<EvidenciaStudentov.Models.Pouzivatel>

@{
    ViewBag.Title = "Používatelia";
}

<div class="container-fluid my-5 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">👥 Používatelia</h1>
            <p class="text-muted mb-0">Zoznam všetkých registrovaných používateľov systému.</p>
        </div>
        <a asp-action="Create" class="custom-toggle-btn btn-lg rounded-pill">
            Pridať používateľa
        </a>
    </div>
    

    <div class="mb-3">
    <input type="text" id="search-input" class="form-control form-control-lg" placeholder="🔍 Hľadať používateľa...">
</div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center py-4">
            Zatiaľ neboli pridaní žiadni používatelia.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded border">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-primary text-center">
                    <tr>
                        <th>ID</th>
                        <th>Meno</th>
                        <th>Priezvisko</th>
                        <th>Dátum narodenia</th>
                        <th>Heslo</th>
                        <th>Email</th>
                        <th>Rola</th>
                        <th class="text-center">Akcie</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.PouzivatelId</td>
                            <td>@item.Meno</td>
                            <td>@item.Priezvisko</td>
                            <td>@item.DatumNarodenia.ToString("dd.MM.yyyy")</td>
                            <td>
                                <span class="text-monospace text-muted">
                                    @item.Heslo
                                </span>
                            </td>
                            <td>@item.Email</td>
                            <td>
                                <span class="badge bg-secondary">@item.Rola</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.PouzivatelId" class="btn btn-outline-primary btn-sm rounded-pill">
                                    ✏️ Upraviť
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.PouzivatelId" class="btn btn-outline-danger btn-sm rounded-pill">
                                    🗑️ Zmazať
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>


<script>
document.getElementById('search-input').addEventListener('input', function () {
    let filter = this.value.toLowerCase();
    let rows = document.querySelectorAll("table tbody tr");

    rows.forEach(row => {
        let text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
    });
});
</script>