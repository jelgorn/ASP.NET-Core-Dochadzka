@model EvidenciaStudentov.Models.Pouzivatel

@{
    ViewBag.Title = "Pridať používateľa";
}

<div class="container py-5">
    <h1 class="text-center fw-bold mb-4">👤 Nový používateľ</h1>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                
 
                <div class="card-body">
                    <form asp-action="Create">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Meno" class="form-label fw-bold">Meno</label>
                                <input asp-for="Meno" class="form-control" placeholder="Zadajte meno">
                                <span asp-validation-for="Meno" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Priezvisko" class="form-label fw-bold">Priezvisko</label>
                                <input asp-for="Priezvisko" class="form-control" placeholder="Zadajte priezvisko">
                                <span asp-validation-for="Priezvisko" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input asp-for="Email" class="form-control" placeholder="napr. meno@domena.sk">
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Heslo" class="form-label fw-bold">Heslo</label>
                                <input asp-for="Heslo" class="form-control" placeholder="Zadajte heslo" type="password">
                                <span asp-validation-for="Heslo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DatumNarodenia" class="form-label fw-bold">Dátum narodenia</label>
                                <input asp-for="DatumNarodenia" class="form-control" type="date" />
                                <span asp-validation-for="DatumNarodenia" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Rola" class="form-label fw-bold">Rola</label>
                                <select asp-for="Rola" class="form-select">
                                    <option value="">-- Vyberte rolu --</option>
                                    <option value="admin">Admin</option>
                                    <option value="ucitel">Učiteľ</option>
                                    <option value="ziak">Žiak</option>
                                </select>
                                <span asp-validation-for="Rola" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <a asp-action="Index" class="custom-toggle-btn rounded-pill px-4 py-2">Späť</a>
                            <button type="submit" class="custom-toggle-btn rounded-pill px-4 py-2">Vytvoriť používateľa</button>
                        </div>
                    </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
