@model EvidenciaStudentov.Models.PriradeniePredmetovUcitelom

@{
    ViewData["Title"] = "Upraviť priradenie";
}

<div class="container py-5">
    <h1 class="text-center fw-bold mb-4">✏️ Upraviť priradenie učiteľa</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="Edit" class="shadow p-4 rounded bg-white">
                <input type="hidden" asp-for="PriradeniePredUcitelId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="PouzivatelId" class="form-label">Učiteľ</label>
                    <select asp-for="PouzivatelId" class="form-select rounded-pill" asp-items="ViewBag.PouzivatelId"></select>
                </div>

                <div class="mb-4">
                    <label asp-for="PredmetId" class="form-label">Predmet</label>
                    <select asp-for="PredmetId" class="form-select rounded-pill" asp-items="ViewBag.PredmetId"></select>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="custom-toggle-btn rounded-pill px-4 py-2">Späť</a>
                    <button type="submit" class="custom-toggle-btn rounded-pill px-4 py-2">Uložiť</button>
                </div>
            </form>
        </div>
    </div>
</div>
